# URL pública do site (metadata, sitemap, robots). Na Vercel, se vazio, usa VERCEL_PROJECT_PRODUCTION_URL.
NEXT_PUBLIC_SITE_URL=

# A cotação é enviada ao comercial pelo WhatsApp (número em lib/site.ts).
# Cópia opcional no servidor: log | resend
LEAD_PROVIDER=log
RESEND_API_KEY=
LEAD_EMAIL_TO=
LEAD_EMAIL_FROM=
