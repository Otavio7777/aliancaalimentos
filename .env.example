# URL pública do site (usada em metadata, sitemap, robots e schema.org).
# Na Vercel, se vazio, usa automaticamente VERCEL_PROJECT_PRODUCTION_URL.
NEXT_PUBLIC_SITE_URL=

# Destino dos leads do formulário (/api/lead): log | resend | supabase
#   log      → apenas registra no log do servidor (stub; padrão)
#   resend   → envia e-mail via Resend
#   supabase → grava na tabela de leads do Supabase
LEAD_PROVIDER=log

# --- Resend (LEAD_PROVIDER=resend) ---
RESEND_API_KEY=
# um ou mais destinatários separados por vírgula
LEAD_EMAIL_TO=
# remetente verificado no Resend (ex.: "Site Aliança <site@seudominio.com.br>")
LEAD_EMAIL_FROM=

# --- Supabase (LEAD_PROVIDER=supabase) ---
SUPABASE_URL=
# chave service_role (somente no servidor; nunca expor no front)
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_LEADS_TABLE=leads
